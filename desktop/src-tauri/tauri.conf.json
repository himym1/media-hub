{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Hub",
  "version": "0.21.2",
  "identifier": "us.ci.himym.mediahub",
  "build": {
    "devUrl": "https://media.himym.us.ci",
    "frontendDist": "https://media.himym.us.ci"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
